# Python 本地环境与解释器缓存
.venv/
__pycache__/
*.py[cod]
*.pyo

# 测试、类型检查与代码质量工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地环境变量、密钥和开发者专属配置
.env
.env.*
!.env.example
*.key
*.pem
/configs/data_paths.local.json

# IDE、编辑器与操作系统生成文件
.idea/
.vscode/
.codex_tmp/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# 已确认超过普通 Git 托管平台单文件限制的本地原始数据（约 590 MB）
/WiSig_CrossDay_40Tx_3Rx_4Day_300Sig_equalized.pkl

# LoRa Setup 1 原始 I/Q 文件体量较大，仅保留 manifest、脚本和小型审计结果入库
/datasets/lora25_compact/raw_setup1_iq/

# 客户补充的超大射频原始数据压缩包及其本地解压目录
/数据集/*.rar
/数据集/*.zip
/数据集/ManyTx.pkl.zip.part*
/数据集/WiSig_CrossDay_40Tx_3Rx_4Day_300Sig_equalized.pkl
/数据集/release_parts*/
/数据集/ADS-B/
/数据集/Dataset/
/数据集/ManyTx/
/数据集/ManyRx/

# 阶段 5 LoRa 本地端到端 smoke 的临时模型与回放记忆；CSV/JSON/Markdown 审计结果保留入库
/results/stage5/lora_mvacc_cil_seed7_local_smoke/*.pth
/results/stage5/lora_mvacc_cil_seed7_local_smoke/*.npz

# 阶段 5 原型锚定矩阵仅将大型训练状态保留在 Slurm；CSV/JSON/Markdown 结果继续入库
/results/stage5/lora_prototype_anchor_seed7_*/*/*.pth
/results/stage5/lora_prototype_anchor_seed7_*/*/*.npz

# Slurm 小型结果同步时的本地中转目录；正式报告、CSV 和 JSON 会整理到对应 results 子目录
/results/stage*/osei_*_results_*/

# Stage 23 报告器本地 smoke 产物；真实 Slurm 报告和 summary 仍然保留入库
/results/stage23/*SMOKE*
/results/stage23/stage23_report_smoke.json

# Stage 23 长窗 LoRa 的重建数据和训练状态保留在 Slurm；manifest、CSV、JSON、Markdown 继续入库
/results/stage23/*.npz
/results/stage23/lora_long1024_joint_seed7_*/*.pth
/results/stage23/lora_long1024_joint_seed7_*/*.npz

# Stage 38 物理域预训练会生成 checkpoint 和回放记忆；报告、CSV 和 JSON 继续保留入库
/results/stage38/*.pth
/results/stage38/lora_physical_pretrain_seed*_*/*.pth
/results/stage38/lora_physical_pretrain_seed*_*/*.npz

# Stage 39 discovery 未标注物理预训练同样只同步小型报告和表格
/results/stage39/*.pth
/results/stage39/lora_discovery_physical_seed*_*/*.pth
/results/stage39/lora_discovery_physical_seed*_*/*.npz

# Stage 40 域对抗预训练只保留报告、表格和日志
/results/stage40/*.pth
/results/stage40/lora_domain_adversarial_seed*_*/*.pth
/results/stage40/lora_domain_adversarial_seed*_*/*.npz
