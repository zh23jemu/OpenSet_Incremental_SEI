# Python 本地环境与解释器缓存
.venv/
__pycache__/
*.py[cod]
*.pyo

# 测试、类型检查与代码质量工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地环境变量、密钥和开发者专属配置
.env
.env.*
!.env.example
*.key
*.pem
/configs/data_paths.local.json

# IDE、编辑器与操作系统生成文件
.idea/
.vscode/
.codex_tmp/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# 已确认超过普通 Git 托管平台单文件限制的本地原始数据（约 590 MB）
/WiSig_CrossDay_40Tx_3Rx_4Day_300Sig_equalized.pkl

# LoRa Setup 1 原始 I/Q 文件体量较大，仅保留 manifest、脚本和小型审计结果入库
/datasets/lora25_compact/raw_setup1_iq/

# 客户补充的超大射频原始数据压缩包及其本地解压目录
/数据集/*.rar
/数据集/*.zip
/数据集/ManyTx.pkl.zip.part*
/数据集/WiSig_CrossDay_40Tx_3Rx_4Day_300Sig_equalized.pkl
/数据集/release_parts*/
/数据集/ADS-B/
/数据集/Dataset/
/数据集/ManyTx/
/数据集/ManyRx/

# 阶段 5 LoRa 本地端到端 smoke 的临时模型与回放记忆；CSV/JSON/Markdown 审计结果保留入库
/results/stage5/lora_mvacc_cil_seed7_local_smoke/*.pth
/results/stage5/lora_mvacc_cil_seed7_local_smoke/*.npz

# 阶段 5 原型锚定矩阵仅将大型训练状态保留在 Slurm；CSV/JSON/Markdown 结果继续入库
/results/stage5/lora_prototype_anchor_seed7_*/*/*.pth
/results/stage5/lora_prototype_anchor_seed7_*/*/*.npz

# Slurm 小型结果同步时的本地中转目录；正式报告、CSV 和 JSON 会整理到对应 results 子目录
/results/stage*/osei_*_results_*/

# Stage 23 报告器本地 smoke 产物；真实 Slurm 报告和 summary 仍然保留入库
/results/stage23/*SMOKE*
/results/stage23/stage23_report_smoke.json

# Stage 23 长窗 LoRa 的重建数据和训练状态保留在 Slurm；manifest、CSV、JSON、Markdown 继续入库
/results/stage23/*.npz
/results/stage23/lora_long1024_joint_seed7_*/*.pth
/results/stage23/lora_long1024_joint_seed7_*/*.npz

# Stage 38 物理域预训练会生成 checkpoint 和回放记忆；报告、CSV 和 JSON 继续保留入库
/results/stage38/*.pth
/results/stage38/lora_physical_pretrain_seed*_*/*.pth
/results/stage38/lora_physical_pretrain_seed*_*/*.npz

# Stage 39 discovery 未标注物理预训练同样只同步小型报告和表格
/results/stage39/*.pth
/results/stage39/lora_discovery_physical_seed*_*/*.pth
/results/stage39/lora_discovery_physical_seed*_*/*.npz

# Stage 40 域对抗预训练只保留报告、表格和日志
/results/stage40/*.pth
/results/stage40/lora_domain_adversarial_seed*_*/*.pth
/results/stage40/lora_domain_adversarial_seed*_*/*.npz

# Stage45 会从完整 LoRa 原始 I/Q 生成本地 cache、长窗 NPZ 和 checkpoint；
# 这些文件体积较大，报告、summary、CSV 和 Slurm 日志仍保留给 Git 同步。
/results/stage45/cache_raw_setup1_*/
/results/stage45/*.npz
/results/stage45/lora_raw_*_seed*_*/*.pth
/results/stage45/lora_raw_*_seed*_*/*.npz

# Stage46 复用完整 LoRa 原始 I/Q 构建 s28 三种子数据；只提交报告和小型 CSV/JSON。
/results/stage46/cache_raw_setup1_s28_*/
/results/stage46/*.npz
/results/stage46/lora_raw_s28_seed*_*/*.pth
/results/stage46/lora_raw_s28_seed*_*/*.npz

# Stage47 seed31 rescue 会复用/重建 LoRa s28 数据和 checkpoint；小型指标仍入库。
/results/stage47/cache_raw_setup1_s28_*/
/results/stage47/*.npz
/results/stage47/lora_s28_seed31_*/*.pth
/results/stage47/lora_s28_seed31_*/*.npz

# Stage48 只提交 rec065 三种子小型指标；checkpoint/NPZ 仍留在训练盘。
/results/stage48/*.npz
/results/stage48/lora_s28_rec065_seed*_*/*.pth
/results/stage48/lora_s28_rec065_seed*_*/*.npz

# Stage49 seed31 rec065 repeat 只提交小型指标和报告；模型权重/回放记忆不入库。
/results/stage49/*.npz
/results/stage49/lora_seed31_rec065_repeat*_*/*.pth
/results/stage49/lora_seed31_rec065_repeat*_*/*.npz

# Stage50 LoRa ratio 矩阵只提交小型指标和日志；checkpoint/replay 留在训练盘。
/results/stage50/*.npz
/results/stage50/lora_seed31_rec065_r*_*/*.pth
/results/stage50/lora_seed31_rec065_r*_*/*.npz

# Stage51 LoRa 新类吸收矩阵：保留小型 CSV/JSON/报告，忽略大模型与回放二进制。
/results/stage51/*.npz
/results/stage51/lora_s51_*_*/*.pth
/results/stage51/lora_s51_*_*/*.npz

# Stage52 LoRa dechirped s28：保留小型 CSV/JSON/报告，忽略大数据集、cache 和模型二进制。
/results/stage52/cache_raw_setup1_dechirped_s28_*/
/results/stage52/*.npz
/results/stage52/lora_dechirped_s28_rec065_seed*_*/*.pth
/results/stage52/lora_dechirped_s28_rec065_seed*_*/*.npz

# Stage55 LoRa raw s28 物理域预训练：checkpoint 和 replay 二进制留在训练盘，报告/CSV/JSON/日志入库。
/results/stage55/*.pth
/results/stage55/lora_s28_physical_seed*_*/*.pth
/results/stage55/lora_s28_physical_seed*_*/*.npz

# Stage56 LoRa refined filter：保留小型 CSV/JSON/报告，忽略每个变体的模型和 replay 二进制。
/results/stage56/lora_s56_*_*/*.pth
/results/stage56/lora_s56_*_*/*.npz

# Stage57 LoRa new-specialist + old-route：保留小型 CSV/JSON/报告，忽略模型、replay 和原型库二进制。
/results/stage57/lora_s57_*_*/*.pth
/results/stage57/lora_s57_*_*/*.npz

# Stage58 LoRa 双模型路由：保留小型 CSV/JSON/报告和日志，忽略模型、replay 与 eval dump 二进制。
/results/stage58/lora_s58_*_*/*.pth
/results/stage58/lora_s58_*_*/*.npz
/results/stage58/lora_s58_*_*/end_to_end_eval_dumps/*.npz

# Stage60 LoRa 累积伪标签重训：保留小型 CSV/JSON/报告和日志，忽略每轮重训 checkpoint。
/results/stage60/lora_s60_*_*/*.pth
